              "size_bytes": 128,
              "line_size_bytes": 64,
              "associativity": 2,
              "replacement_policy": "FIFO"
            },
            {
              "name": "L2",
              "size_bytes": 64,
              "line_size_bytes": 64,
              "associativity": 1,
