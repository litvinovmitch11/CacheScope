{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CacheScope trace v1",
  "type": "object",
  "required": [
    "schema",
    "producer",
    "variant",
    "valid",
    "complete",
    "total_events",
    "recorded_events",
    "truncated",
    "errors",
    "accesses",
    "events"
  ],
  "properties": {
    "schema": {"const": "cachescope.trace.v1"},
    "producer": {
      "type": "object",
      "required": [
        "name",
        "version",
        "llvm_version",
        "llvm_revision",
        "pipeline_fingerprint"
      ],
      "properties": {
        "name": {"const": "CacheScope"},
        "version": {"type": "string"},
        "llvm_version": {"type": "string"},
        "llvm_revision": {"type": "string"},
        "pipeline_fingerprint": {"type": "string"}
      },
      "additionalProperties": true
    },
    "variant": {"type": "string"},
    "valid": {"type": "boolean"},
    "complete": {"type": "boolean"},
    "total_events": {"type": "integer", "minimum": 0},
    "recorded_events": {"type": "integer", "minimum": 0},
    "truncated": {"type": "boolean"},
    "errors": {"type": "array", "items": {"type": "string"}},
    "accesses": {
      "type": "array",
      "items": {"$ref": "#/$defs/access"}
    },
    "events": {
      "type": "array",
      "items": {"$ref": "#/$defs/event"}
    }
  },
  "$defs": {
    "kind": {"enum": ["read", "write", "read_write"]},
    "event_kind": {"enum": ["read", "write", "read_write", "invalid"]},
    "address_kind": {"enum": ["memref_offset", "process_address"]},
    "access": {
      "type": "object",
      "required": [
        "access_id",
        "memref_id",
        "kind",
        "address_kind",
        "source_location"
      ],
      "properties": {
        "access_id": {"type": "integer"},
        "memref_id": {"type": "integer"},
        "kind": {"$ref": "#/$defs/kind"},
        "address_kind": {"$ref": "#/$defs/address_kind"},
        "source_location": {"type": "string"}
      },
      "additionalProperties": true
    },
    "event": {
      "type": "object",
      "required": [
        "sequence",
        "access_id",
        "memref_id",
        "byte_offset",
        "size_bytes",
        "kind",
        "address_kind"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "access_id": {"type": "integer", "minimum": 0},
        "memref_id": {"type": "integer"},
        "byte_offset": {"type": "integer"},
        "size_bytes": {"type": "integer"},
        "kind": {"$ref": "#/$defs/event_kind"},
        "address_kind": {"$ref": "#/$defs/address_kind"}
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"valid": {"const": true}},
        "required": ["valid"]
      },
      "then": {
        "properties": {
          "events": {
            "items": {
              "properties": {
                "access_id": {"minimum": 0},
                "size_bytes": {"minimum": 1},
                "kind": {"$ref": "#/$defs/kind"}
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
