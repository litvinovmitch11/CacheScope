HeaderFilterRegex: '.*/compiler/.*'
Checks: >
  -*,
  clang-diagnostic-*,
  clang-analyzer-*,
  llvm-*,
  misc-*,
  -misc-const-correctness,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  -misc-unused-parameters,
  -misc-use-anonymous-namespace,
  performance-*,
  portability-*,
  readability-redundant-*
WarningsAsErrors: '*'
